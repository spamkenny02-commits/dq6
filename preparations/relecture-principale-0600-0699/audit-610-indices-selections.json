    },
    {
      "FR_file": "data/MESS6/FR/0072.p",
      "JA_file": "data/MESS6/JA/0072.p",
      "id": 60,
      "FR_text": "@aKad Abra@bJe vous ai dit que l'épée était dans la grotte gelée au nord, nonⓡ Alors, filez-yⓠ\n@c0@",
      "JA_text": "@a@bザム「剣は　この村から北の\n\t氷に　おおわれた　洞くつに眠る。\n\t心して　ゆくがよい！\n@c0@",
      "scope": "SOURCE_DS_EXPLICITE_ADAPTEE_AU_SFC",
